{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "description": [
    "ignorePaths replaces, rather than extends, the list that config:recommended inherits from :ignoreModulesAndTests. It is restated here minus **/tests/**, which hid wpilib/tests/Dockerfile from Renovate and let its emscripten/emsdk pin drift behind wpilib/Dockerfile.",
    "wpilib/tests/ is the only path this un-ignores: playwright-tests/ never matched the pattern, and scripts/ingest/__tests__/ stays ignored through **/__tests__/**."
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**"
  ],
  "packageRules": [
    {
      "groupName": "icons",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@iconify-json/**", "@svgr/**", "unplugin-icons"]
    },
    {
      "groupName": "math",
      "matchManagers": ["npm"],
      "matchPackageNames": ["js-quantities", "@types/js-quantities"]
    },
    {
      "groupName": "oxc",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "oxfmt",
        "oxlint",
        "oxlint-tsgolint",
        "oxlint-tailwindcss",
        "eslint-plugin-no-relative-import-paths",
        "eslint-plugin-zod"
      ]
    },
    {
      "groupName": "react",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "@base-ui/react"
      ]
    },
    {
      "groupName": "react-router",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@react-router/**",
        "@vercel/react-router",
        "react-router"
      ]
    },
    {
      "groupName": "testing",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@playwright/test",
        "vitest",
        "jsdom",
        "@testing-library/**"
      ]
    },
    {
      "groupName": "typescript",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript", "@types/node"]
    },
    {
      "groupName": "vite",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vite", "vite-**", "@tailwindcss/vite"]
    },
    {
      "description": "Must follow the vite rule: the last matching rule wins, so @tailwindcss/vite groups here",
      "groupName": "tailwind",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/**",
        "tailwind-merge",
        "tw-animate-css",
        "class-variance-authority",
        "clsx"
      ]
    },
    {
      "description": "Must follow the vite rule: the last matching rule wins, so vite-plugin-comlink groups here instead of with unrelated vite-** bumps",
      "groupName": "comlink",
      "matchManagers": ["npm"],
      "matchPackageNames": ["comlink", "vite-plugin-comlink"]
    },
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Pinned in both wpilib/Dockerfile and wpilib/tests/Dockerfile; they must move together. This depends on ignorePaths above keeping wpilib/tests/ scannable.",
      "groupName": "emscripten",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["emscripten/emsdk"]
    },
    {
      "description": "Pinned in .mise.toml, wpilib/.mise.toml and package.json engines",
      "groupName": "node",
      "matchPackageNames": ["node"]
    },
    {
      "description": "Pinned in .mise.toml and package.json packageManager",
      "groupName": "pnpm",
      "matchPackageNames": ["pnpm"]
    },
    {
      "description": "Stay on Temurin 21 LTS; the JDK only feeds the wpilib build container",
      "matchPackageNames": ["java"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "clang-format resolves through mise's conda backend, which the mise manager cannot read",
      "managerFilePatterns": ["/(^|/)\\.mise\\.toml$/"],
      "matchStrings": ["clang-format\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "clang-format",
      "packageNameTemplate": "conda-forge/clang-format",
      "datasourceTemplate": "conda"
    }
  ]
}
